generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  pending
  under_review
  approved
  rejected
  revision_requested
}

enum AdminRole {
  compliance_officer
  admin
  super_admin
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(compliance_officer)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model KycApplication {
  id        String            @id @default(cuid())
  referenceId String          @unique
  status    ApplicationStatus @default(pending)

  fullName          String  @default("")
  firstName         String
  fatherName        String
  grandfatherName   String  @default("")
  phone             String
  email             String
  dob               String  @default("")
  age               String  @default("")
  placeOfBirth      String  @default("")
  gender            String  @default("")
  maritalStatus     String  @default("")
  nationality       String  @default("")
  countryOfResidence String @default("")
  residentialStatus String  @default("")
  tinNumber         String  @default("")

  cityAdministration String @default("")
  zone               String @default("")
  subCity            String @default("")
  woredaKebele       String @default("")
  houseNumber        String @default("")
  tel                String  @default("")
  preferredContact   String @default("phone")
  marketingCommunications Boolean @default(false)

  employmentStatus String @default("")
  occupation       String  @default("")
  employerName     String  @default("")
  employerAddress  String  @default("")
  employerPhone    String  @default("")
  businessName     String  @default("")
  natureOfBusiness String  @default("")
  profession       String  @default("")
  businessPhone    String  @default("")

  hasBeneficiary           Boolean @default(false)
  beneficiaryName          String  @default("")
  beneficiaryRelationship  String  @default("")

  bankName       String  @default("")
  bankBranch     String  @default("")
  accountNumber  String  @default("")
  accountTitle   String  @default("")
  bankChangeAck  Boolean @default(false)
  settlementOptions Json  @default("[]")

  investorType    String @default("")
  idType          String @default("")
  idNumber          String @default("")
  idIssueDate       String @default("")
  idExpiryDate      String @default("")
  faydaNumber     String @default("")
  faydaIssueDate  String @default("")
  faydaExpiryDate String @default("")
  faydaFront      String?
  faydaBack       String?
  passportNumber      String @default("")
  passportIssueDate   String @default("")
  passportExpiryDate  String @default("")
  kebeleIdNumber      String @default("")
  kebeleIssueDate     String @default("")
  kebeleExpiryDate    String @default("")
  kebeleId        String?
  drivingLicense  String?

  // Corporate account fields
  companyName             String  @default("")
  investorCategory        String  @default("")
  economicSector          String  @default("")
  registeredAddress       String  @default("")
  country                 String  @default("")
  postalCode              String  @default("")
  registrationNumber      String  @default("")
  registrationDate        String  @default("")
  corporateContacts       Json    @default("[]")
  companyStamp            String?

  // Joint account secondary holder fields
  jointFullName           String  @default("")
  jointGender             String  @default("")
  jointMaritalStatus      String  @default("")
  jointNationality        String  @default("")
  jointTin                String  @default("")
  jointDob                String  @default("")
  jointIdType             String  @default("")
  jointIdNumber           String  @default("")
  jointIdIssueDate        String  @default("")
  jointIdExpiryDate       String  @default("")
  jointRegion             String  @default("")
  jointCity               String  @default("")
  jointSubCity            String  @default("")
  jointWoredaKebele       String  @default("")
  jointHouseNumber        String  @default("")
  jointPhone              String  @default("")
  jointEmail              String  @default("")
  jointTel                String  @default("")
  jointResidentialStatus  String  @default("")
  jointEmploymentStatus   String  @default("")
  jointEmployerName       String  @default("")
  jointProfession         String  @default("")
  jointEmployerAddress    String  @default("")
  jointBusinessAddress    String  @default("")
  jointAnnualIncome       String  @default("")
  jointSourceOfFunds      String  @default("")
  jointPepStatus          String  @default("no")
  jointPepDetails         String  @default("")

  publiclyTradedOwner      String @default("no")
  publiclyTradedDetails    String @default("")
  brokerageEmployee        String @default("no")
  brokerageEmployeeDetails String @default("")

  sourceOfFunds         String @default("")
  sourceOfIncomeDetails String @default("")
  annualNetIncome       String @default("")
  netWorth              String @default("")

  pepStatus    String @default("no")
  pepDetails   String @default("")

  bankruptcyDisclosure String @default("no")
  bankruptcyDetails    String @default("")

  criminalRecord        String @default("no")
  criminalRecordDetails String @default("")

  riskTolerance String @default("")

  stockExperience           String @default("")
  bondExperience            String @default("")
  stockMonthlyValue         String @default("")
  fixedIncomeMonthlyValue   String @default("")

  investmentObjective Json @default("[]")
  investmentType      String @default("")

  ownerType           String @default("")
  ownershipCompanies  Json   @default("[]")

  applicantName            String  @default("")
  applicantSignature       String  @default("")
  jointApplicantSignature  String  @default("")
  dateOfApplication        String  @default("")
  submitConsent              Boolean @default(false)
  riskDisclosureAck          Boolean @default(false)
  accountCode                String  @default("")
  officeUse                  Json    @default("{}")
  authorizedSignatoryName    String  @default("")
  authorizedSignatoryTitle   String  @default("")

  reviewNotes String   @default("")
  reviewedBy  String?
  reviewedAt  DateTime?
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([submittedAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  referenceId    String?
  applicant      String?
  email          String?
  previousStatus String?
  newStatus      String?
  reviewedBy     String?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model KycCounter {
  id    String @id @default("kyc")
  value Int    @default(100000)
}

model TradeOrder {
  id               String   @id @default(cuid())
  orderId          String   @unique
  clientName       String
  idNumber         String
  csdAccountNumber String
  symbol           String
  side             String   // BUY or SELL
  type             String   // MARKET, LIMIT, STOP, STOP_LIMIT
  limitPrice       String   @default("")
  stopPrice        String   @default("")
  quantity         String   @default("")
  timeInForce      String   // DAY, GTC, GTD
  goodTillDate     String   @default("")
  clientSignature  String   @default("")
  clientSignatureDate String @default("")
  receivedVia      String   // In Person, Neway App
  status           String   @default("Pending") // Accepted, Rejected, Pending
  rejectionReason  String   @default("")
  traderSignature  String   @default("")
  receivedBy       String   @default("")
  dateReceived     String   @default("")
  timeReceived     String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
