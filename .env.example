# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://prime:prime_secret@localhost:5434/prime_capital?schema=public"

# Auth
JWT_SECRET="dev-only-secret-min-32-characters-long!!"
JWT_EXPIRES_IN="8h"

# Seed admin (run once: npm run prisma:seed)
ADMIN_SEED_EMAIL="compliance@primecapital.et"
ADMIN_SEED_PASSWORD="Admin@12345"
ADMIN_SEED_NAME="Compliance Officer"

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://www.primecapitalsc.com,https://primecapitalsc.com,https://admin.primecapitalsc.com"

# --- Object storage (MinIO / S3) ---
# Leave unset for local dev (files saved to uploads/)
# Uncomment after: npm run db:up

# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="prime-capital-kyc"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_SSL="false"
# S3_REGION="us-east-1"
# S3_FORCE_PATH_STYLE="true"
# S3_PREFIX="kyc"

# Production example:
# S3_ENDPOINT="https://minio.internal:9000"
# S3_BUCKET="prime-capital-kyc-prod"
# S3_SSL="true"
# S3_FORCE_PATH_STYLE="true"
